# Backend API
DATABASE_URL="mysql://user:password@localhost:3306/liviasdb"
JWT_SECRET="change-me-to-a-long-random-secret"
PORT=3333

# IA (grátis via OpenRouter - https://openrouter.ai)
# Crie uma chave gratuita em OpenRouter > Settings > Keys (sem cartão de crédito)
OPENROUTER_API_KEY="sk-or-..."
# Modelos gratuitos separados por vírgula (ordem de tentativa; pula para o próximo se um falhar).
# Os modelos grátis rotacionam no OpenRouter — consulte https://openrouter.ai/models (filtro :free)
AI_MODELS="openai/gpt-oss-20b:free,google/gemma-4-31b-it:free,inclusionai/ling-3.0-flash:free,nvidia/nemotron-3-super-120b-a12b:free,deepseek/deepseek-chat:free"
